{
  "info": {
    "name": "Gym Management - Workouts API",
    "description": "Postman collection for Workouts API in Gym Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Workouts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/workouts/get",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts",
            "get"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Workout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Full Body HIIT",
              "type": "text"
            },
            {
              "key": "targetmuscle",
              "value": "Full Body",
              "type": "text"
            },
            {
              "key": "difficultlevel",
              "value": "Advanced",
              "type": "text"
            },
            {
              "key": "duration",
              "value": "45",
              "type": "text"
            },
            {
              "key": "description",
              "value": "High intensity interval training",
              "type": "text"
            },
            {
              "key": "trainerId",
              "value": "1",
              "type": "text"
            },
            {
              "key": "workoutimage",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/workouts/add",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts",
            "add"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Edit Workout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Full Body HIIT - Updated",
              "type": "text"
            },
            {
              "key": "workoutimage",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/workouts/edit/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts",
            "edit",
            "1"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Workout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/workouts/delete/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts",
            "delete",
            "1"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search Workout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"query\": \"HIIT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workouts/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts",
            "search"
          ]
        }
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN",
      "type": "string"
    }
  ]
}
