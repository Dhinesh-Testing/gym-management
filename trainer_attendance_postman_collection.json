{
  "info": {
    "name": "Gym Management - Trainer Attendance",
    "description": "APIs to track check-ins and check-outs for trainers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Trainer Attendance",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{token}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/trainer-attendance/get",
          "host": ["{{base_url}}"],
          "path": ["trainer-attendance", "get"]
        }
      }
    },
    {
      "name": "Mark Trainer Check-In",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{token}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"trainerId\": 1,\n    \"date\": \"2026-09-15\",\n    \"checkInTime\": \"09:00:00\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/trainer-attendance/check-in/add",
          "host": ["{{base_url}}"],
          "path": ["trainer-attendance", "check-in", "add"]
        }
      }
    },
    {
      "name": "Mark Trainer Check-Out",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{token}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"trainerId\": 1,\n    \"date\": \"2026-09-15\",\n    \"checkOutTime\": \"17:00:00\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/trainer-attendance/check-in/add",
          "host": ["{{base_url}}"],
          "path": ["trainer-attendance", "check-in", "add"]
        }
      }
    },
    {
      "name": "Get Specific Trainer Attendance",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{token}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/trainer-attendance/trainer/1",
          "host": ["{{base_url}}"],
          "path": ["trainer-attendance", "trainer", "1"]
        }
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "your_jwt_token_here", "type": "string" }
  ]
}
